{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencertflow.io/schema/ruleset.schema.json",
  "title": "OpenCertFlow 인증 룰셋",
  "description": "제품군별 인증 판정 룰셋. 구조와 열거값만 검증한다. 속성과 값 타입의 정합성(예: RATED_VOLTAGE에 문자열), 절대 발동하지 않는 조건, 중복 룰 코드 등 의미 수준 검사는 `opencertflow validate`가 수행한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["productGroup", "version", "rules"],
  "properties": {
    "productGroup": {
      "description": "제품군. 새 제품군을 추가하려면 ProductGroup 열거형에도 추가해야 한다.",
      "$ref": "#/$defs/productGroup"
    },
    "version": {
      "description": "룰셋 버전. 제품군 안에서 유일하다. 진단은 평가 시점의 버전을 스냅샷으로 보관한다.",
      "type": "integer",
      "minimum": 1
    },
    "active": {
      "description": "이 버전을 활성 룰셋으로 쓸지 여부. 제품군당 활성 룰셋은 하나만 허용된다.",
      "type": "boolean",
      "default": false
    },
    "description": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },

  "$defs": {
    "productGroup": {
      "type": "string",
      "enum": ["SMALL_APPLIANCE", "ELECTRIC_HEATING_PAD"]
    },

    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "priority", "condition", "effects"],
      "properties": {
        "code": {
          "description": "룰 식별자. 룰셋 안에서 유일하다. 진단 결과의 근거 추적에 쓰인다.",
          "type": "string",
          "pattern": "^R-[A-Z]{2,6}-[0-9]{3}[A-Z]?$"
        },
        "priority": {
          "description": "평가 순서. 작을수록 먼저 평가된다. 효과는 누적되므로 순서가 결과를 바꾸지는 않지만, 근거 기록(RuleTrace) 순서를 결정한다.",
          "type": "integer",
          "minimum": 0
        },
        "description": { "type": "string" },
        "condition": { "$ref": "#/$defs/condition" },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/effect" }
        }
      }
    },

    "condition": {
      "description": "룰 발동 조건. 논리 조합(allOf/anyOf/not)과 단말 비교(attr)의 트리.",
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/$defs/allOf" },
        { "$ref": "#/$defs/anyOf" },
        { "$ref": "#/$defs/not" },
        { "$ref": "#/$defs/attr" }
      ]
    },

    "allOf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "conditions"],
      "properties": {
        "type": { "const": "allOf" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },

    "anyOf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "conditions"],
      "properties": {
        "type": { "const": "anyOf" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },

    "not": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "condition"],
      "properties": {
        "type": { "const": "not" },
        "condition": { "$ref": "#/$defs/condition" }
      }
    },

    "attr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attribute", "operator"],
      "properties": {
        "type": { "const": "attr" },
        "attribute": {
          "description": "비교할 제품 속성.",
          "type": "string",
          "enum": [
            "USES_ELECTRICITY", "RATED_VOLTAGE", "POWER_CONSUMPTION", "HAS_BATTERY", "POWER_SOURCE", "APPLIANCE_ITEM",
            "BODY_CONTACT_TYPE", "CONTROLLER_STATUS", "ADJUSTMENT_STEPS", "ADJUSTMENT_MODE",
            "MAX_SURFACE_TEMPERATURE", "TEMPERATURE_SOURCE", "MEDICAL_USE_CLAIM",
            "AUTO_SHUT_OFF", "AUTO_SHUT_OFF_MINUTES", "OVERHEAT_PROTECTION",
            "TEMPERATURE_LIMIT_DEVICE", "REMOVABLE_COVER", "WASHABLE",
            "SEPARABLE_ELECTRIC_PARTS", "HAS_SEPARATE_ADAPTER",
            "ADAPTER_EXTERNALLY_ATTACHED", "ADAPTER_CERTIFIED",
            "TARGET_USER", "SALES_CHANNEL", "MANUFACTURING_TYPE", "IS_MODIFIED_MODEL",
            "PRODUCT_GROUP", "MATERIALS", "HELD_DOCUMENTS"
          ]
        },
        "operator": {
          "description": "IN은 값 집합 중 하나와 일치하는지, CONTAINS는 컬렉션 속성이 값을 포함하는지 검사한다.",
          "type": "string",
          "enum": ["EQ", "NEQ", "GT", "GTE", "LT", "LTE", "IN", "CONTAINS"]
        },
        "value": {
          "description": "비교 대상 값. null은 '값 부재'를 검사한다(예: 정격전압 미상). 배열은 IN에 쓴다.",
          "type": ["boolean", "integer", "string", "null", "array"],
          "items": { "type": ["boolean", "integer", "string"] }
        }
      }
    },

    "effect": {
      "description": "룰이 발동했을 때 진단 결과에 더해지는 것. 효과는 누적적이다.",
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/$defs/addCandidate" },
        { "$ref": "#/$defs/requireDocument" },
        { "$ref": "#/$defs/addLabelingCheck" },
        { "$ref": "#/$defs/flagExpertReview" }
      ]
    },

    "addCandidate": {
      "description": "인증 검토 후보를 추가한다. 같은 (제도, 등급) 조합은 병합되고 매칭 룰이 합쳐진다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schemeCode", "certificationType"],
      "properties": {
        "type": { "const": "addCandidate" },
        "schemeCode": { "type": "string", "minLength": 1 },
        "certificationType": {
          "type": "string",
          "enum": ["SAFETY_CERT", "SAFETY_CONFIRM", "SUPPLIER_DOC"]
        }
      }
    },

    "requireDocument": {
      "description": "서류를 요구한다. 같은 서류를 여러 룰이 요구하면 더 강한 요구(REQUIRED)가 이긴다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "documentCode", "requirement"],
      "properties": {
        "type": { "const": "requireDocument" },
        "documentCode": {
          "description": "weights/document-weights.yaml에 가중치가 정의되어 있어야 점수에 반영된다.",
          "type": "string",
          "minLength": 1
        },
        "requirement": { "type": "string", "enum": ["REQUIRED", "RECOMMENDED"] }
      }
    },

    "addLabelingCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "const": "addLabelingCheck" },
        "label": { "type": "string", "minLength": 1 }
      }
    },

    "flagExpertReview": {
      "description": "판단하지 않고 전문가 확인으로 격리한다. 확인되지 않은 것을 단정하지 않기 위한 장치다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question", "reason"],
      "properties": {
        "type": { "const": "flagExpertReview" },
        "question": { "type": "string", "minLength": 1 },
        "reason": {
          "description": "NO_MATCHING_RULE은 룰 엔진이 자동으로 붙이므로 룰 파일에 직접 쓰지 않는다.",
          "type": "string",
          "enum": ["NO_EVIDENCE", "AMBIGUOUS_CONDITION"]
        }
      }
    }
  }
}
