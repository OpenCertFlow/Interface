{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencertflow.io/schema/document-weights.schema.json",
  "title": "OpenCertFlow 준비도 가중치 기준표",
  "description": "준비도 점수 = (보유 서류 가중치 합) / (요구 서류 가중치 합) × 100. 점수 근거를 공개하기 위해 코드가 아니라 데이터로 관리한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["weights"],
  "properties": {
    "weights": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/weight" }
    }
  },
  "$defs": {
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentCode", "displayName", "requirement", "weight"],
      "properties": {
        "documentCode": {
          "description": "룰의 requireDocument.documentCode와 일치해야 한다. 어긋나면 그 서류는 점수에 반영되지 않는다.",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "requirement": { "type": "string", "enum": ["REQUIRED", "RECOMMENDED"] },
        "weight": {
          "description": "클수록 점수 기여가 크다. 필수 서류에 높은 값을 둔다.",
          "type": "integer",
          "minimum": 1
        },
        "note": { "type": "string" }
      }
    }
  }
}
