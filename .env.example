# OpenCertFlow 로컬 실행 환경변수 예시
#
# 이 파일을 .env로 복사해 값을 채운다. .env는 .gitignore에 있어 커밋되지 않는다.
#   cp .env.example .env
#
# 애플리케이션은 .env를 자동으로 읽지 않는다. 셸에서 export 하거나
# docker compose의 env_file로 넘긴다.

# ── 필수 (운영) ─────────────────────────────────────────────────────────────
# prod 프로파일에서 이 둘이 없으면 기동이 실패한다(ProductionSecretGuard).
# JWT 시크릿은 HS256이라 32바이트 이상이어야 한다.
OPENCERTFLOW_AUTH_JWT_SECRET=
# 개인정보 암호화 키(Base64, 32바이트). 바뀌면 기존 데이터를 복호화할 수 없다.
OPENCERTFLOW_SECURITY_ENCRYPTION_KEY=

# ── 법제처 국가법령정보 API ─────────────────────────────────────────────────
# 신청: https://open.law.go.kr/LSO/openApi/cuAskList.do
# 발급된 OC 값을 넣는다(이메일 ID 또는 숫자). 없으면 개정 감지 기능만 꺼진다.
OPENCERTFLOW_LAW_ENABLED=false
OPENCERTFLOW_LAW_OC=

# ── 룰 정의 파일 ────────────────────────────────────────────────────────────
# 비우면 jar에 포함된 rules/를 쓴다. 자신의 룰셋을 쓰려면 디렉터리를 가리킨다.
OPENCERTFLOW_RULES_PATH=
OPENCERTFLOW_WEIGHTS_PATH=

# ── 소셜 로그인 (선택) ──────────────────────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
