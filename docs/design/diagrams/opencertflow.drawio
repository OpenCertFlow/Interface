          <mxGeometry x="380" y="132" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t-comp" value="COMPLETED" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t-degr" value="COMPLETED_DEGRADED" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t-fail" value="FAILED" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="330" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t-cons" value="CONSULTING_REQUESTED" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="880" y="132" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="t-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="t-init" target="t-req"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e2" value="룰 평가 · 점수 산정 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="t-req" target="t-eval"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e3" value="룰셋 로드 실패" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c62828;exitX=0.5;exitY=1;" edge="1" parent="1" source="t-req" target="t-fail">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="360" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="t-e4" value="근거 · 문장화 성공" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="t-eval" target="t-comp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e5" value="근거 또는 문장화 실패" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ef6c00;" edge="1" parent="1" source="t-eval" target="t-degr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e6" value="저장 실패" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c62828;exitX=0.5;exitY=1;" edge="1" parent="1" source="t-eval" target="t-fail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e7" value="컨설팅 연결 요청" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="t-comp" target="t-cons"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t-e8" value="컨설팅 연결 요청" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="t-degr" target="t-cons"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="t-note" value="&lt;b&gt;COMPLETED_DEGRADED는 실패가 아니다.&lt;/b&gt;&lt;br&gt;판정과 준비도 점수는 COMPLETED와 완전히 동일하게 유효하다. 근거 문단 또는 설명 문장만 결여된 상태이며, 사용자에게는 배너로 알린다.&lt;br&gt;&lt;br&gt;진단을 실패시키는 것은 오직 &lt;b&gt;룰셋 로드 실패&lt;/b&gt;와 &lt;b&gt;저장 실패&lt;/b&gt; 두 가지다. 둘 다 폴백이 존재하지 않는다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="1020" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

